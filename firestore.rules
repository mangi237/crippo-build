rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Core primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isBootstrappedAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'nanolabsolutions26@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)))
        || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true);
    }

    // Validation helpers
    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'fullName', 'email', 'anonymousId', 'admin', 'isVerifiedCreator', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'fullName', 'email', 'city', 'anonymousId', 'avatarUrl',
          'walletBalanceXAF', 'momoPhone', 'momoNetwork',
          'admin', 'isVerifiedCreator', 'creatorId', 'totalRaisedXAF',
          'currentValuationXAF', 'completedMilestones', 'createdAt', 'updatedAt'
        ])
        && data.uid == userId
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && (!('city' in data) || (data.city is string && data.city.size() <= 80))
        && data.anonymousId is string && data.anonymousId.size() >= 3 && data.anonymousId.size() <= 40
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500))
        && (!('walletBalanceXAF' in data) || (data.walletBalanceXAF is number && data.walletBalanceXAF >= 0))
        && (!('momoPhone' in data) || (data.momoPhone is string && data.momoPhone.size() <= 40))
        && (!('momoNetwork' in data) || data.momoNetwork in ['MTN MoMo', 'Orange Money'])
        && data.admin is bool
        && data.isVerifiedCreator is bool
        && (!('creatorId' in data) || (data.creatorId is string && data.creatorId.size() <= 128))
        && (!('totalRaisedXAF' in data) || (data.totalRaisedXAF is number && data.totalRaisedXAF >= 0))
        && (!('currentValuationXAF' in data) || (data.currentValuationXAF is number && data.currentValuationXAF >= 0))
        && (!('completedMilestones' in data) || (data.completedMilestones is number && data.completedMilestones >= 0))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidCreator(data, creatorId) {
      return data.keys().hasAll([
          'id', 'ownerUid', 'name', 'handle', 'category', 'sharePriceXAF',
          'priceChangePct', 'tradingVolumeXAF', 'isVerified', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'name', 'handle', 'raiseTitle', 'raiseTitleFr', 'summary', 'summaryFr',
          'avatarUrl', 'coverUrl', 'category', 'city', 'platform', 'status', 'claimStatus', 'claimedByUid',
          'escrowStatus', 'distributorSplitEmail', 'followersCount', 'engagementRate', 'viewVelocity',
          'crippoScore', 'underwritingScore', 'projected12mRevenueXAF',
          'netBudgetXAF', 'grossTargetXAF', 'totalShares', 'sharesRemaining', 'investorsCount',
          'tradingVolumeXAF', 'baseSharePriceXAF', 'sharePriceXAF', 'priceChangePct',
          'sparkline', 'priceHistory', 'totalRaisedXAF', 'targetRaiseXAF', 'revSharePct',
          'roiDurationMonths', 'closesAt', 'isVerified', 'milestonesCompleted',
          'createdAt', 'updatedAt'
        ])
        && data.id == creatorId
        && isValidId(data.ownerUid)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.handle is string && data.handle.size() >= 1 && data.handle.size() <= 80
        && (!('raiseTitle' in data) || (data.raiseTitle is string && data.raiseTitle.size() <= 160))
        && (!('raiseTitleFr' in data) || (data.raiseTitleFr is string && data.raiseTitleFr.size() <= 160))
        && (!('summary' in data) || (data.summary is string && data.summary.size() <= 500))
        && (!('summaryFr' in data) || (data.summaryFr is string && data.summaryFr.size() <= 500))
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500))
        && (!('coverUrl' in data) || (data.coverUrl is string && data.coverUrl.size() <= 500))
        && data.category in [
          'Music & Albums', 'TikTok Series', 'Movies & Docs', 'Podcasts', 'Brand Campaigns',
          'Music', 'Entertainment', 'Comedy', 'Film', 'Tech', 'Lifestyle'
        ]
        && (!('city' in data) || (data.city is string && data.city.size() <= 80))
        && (!('platform' in data) || data.platform in ['TikTok', 'Facebook', 'YouTube', 'Multi-Platform'])
        && (!('status' in data) || data.status in ['OPEN', 'FUNDED', 'ENDED'])
        && (!('claimStatus' in data) || data.claimStatus in ['UNCLAIMED', 'CLAIMED'])
        && (!('claimedByUid' in data) || (data.claimedByUid is string && data.claimedByUid.size() <= 128))
        && (!('escrowStatus' in data) || data.escrowStatus in ['ESCROW_HOLDING', 'TRANCHE_1_RELEASED', 'COMPLETED_LOCKED'])
        && (!('distributorSplitEmail' in data) || (data.distributorSplitEmail is string && data.distributorSplitEmail.size() <= 160))
        && (!('followersCount' in data) || (data.followersCount is number && data.followersCount >= 0))
        && (!('engagementRate' in data) || (data.engagementRate is number && data.engagementRate >= 0))
        && (!('viewVelocity' in data) || (data.viewVelocity is number && data.viewVelocity >= 0))
        && (!('crippoScore' in data) || (data.crippoScore is number && data.crippoScore >= 0))
        && (!('underwritingScore' in data) || (data.underwritingScore is number && data.underwritingScore >= 0))
        && (!('projected12mRevenueXAF' in data) || (data.projected12mRevenueXAF is number && data.projected12mRevenueXAF >= 0))
        && (!('netBudgetXAF' in data) || (data.netBudgetXAF is number && data.netBudgetXAF >= 0))
        && (!('grossTargetXAF' in data) || (data.grossTargetXAF is number && data.grossTargetXAF >= 0))
        && (!('totalShares' in data) || (data.totalShares is number && data.totalShares >= 1))
        && (!('sharesRemaining' in data) || (data.sharesRemaining is number && data.sharesRemaining >= 0))
        && (!('investorsCount' in data) || (data.investorsCount is number && data.investorsCount >= 0))
        && data.tradingVolumeXAF is number && data.tradingVolumeXAF >= 0
        && (!('baseSharePriceXAF' in data) || (data.baseSharePriceXAF is number && data.baseSharePriceXAF > 0))
        && data.sharePriceXAF is number && data.sharePriceXAF > 0
        && data.priceChangePct is number
        && (!('sparkline' in data) || (data.sparkline is list && data.sparkline.size() <= 30 && (data.sparkline.size() == 0 || data.sparkline[0] is number)))
        && (!('priceHistory' in data) || (data.priceHistory is list && data.priceHistory.size() <= 60 && (data.priceHistory.size() == 0 || data.priceHistory[0] is map)))
        && (!('totalRaisedXAF' in data) || (data.totalRaisedXAF is number && data.totalRaisedXAF >= 0))
        && (!('targetRaiseXAF' in data) || (data.targetRaiseXAF is number && data.targetRaiseXAF >= 0))
        && (!('revSharePct' in data) || (data.revSharePct is number && data.revSharePct >= 0 && data.revSharePct <= 100))
        && (!('roiDurationMonths' in data) || (data.roiDurationMonths is number && data.roiDurationMonths >= 1))
        && (!('closesAt' in data) || (data.closesAt is string && data.closesAt.size() <= 64))
        && data.isVerified is bool
        && (!('milestonesCompleted' in data) || (data.milestonesCompleted is number && data.milestonesCompleted >= 0))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidPrediction(data, predictionId) {
      return data.keys().hasAll([
          'id', 'category', 'questionEn', 'questionFr', 'yesShares', 'noShares',
          'yesPoolXAF', 'noPoolXAF', 'yesProbabilityPct', 'noProbabilityPct',
          'totalVolumeXAF', 'status', 'closesAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'creatorId', 'creatorName', 'category', 'questionEn', 'questionFr',
          'resolutionCriteria', 'thumbnailUrl', 'yesShares', 'noShares', 'yesPoolXAF',
          'noPoolXAF', 'yesProbabilityPct', 'noProbabilityPct', 'totalVolumeXAF',
          'sparkline', 'status', 'closesAt', 'createdAt', 'updatedAt'
        ])
        && data.id == predictionId
        && (!('creatorId' in data) || (data.creatorId is string && data.creatorId.size() <= 128))
        && (!('creatorName' in data) || (data.creatorName is string && data.creatorName.size() <= 120))
        && data.category in ['Music & Albums', 'TikTok Series', 'Movies & Docs', 'Awards', 'Culture', 'Tech']
        && data.questionEn is string && data.questionEn.size() >= 5 && data.questionEn.size() <= 240
        && data.questionFr is string && data.questionFr.size() >= 5 && data.questionFr.size() <= 240
        && (!('resolutionCriteria' in data) || (data.resolutionCriteria is string && data.resolutionCriteria.size() <= 500))
        && (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 500))
        && data.yesShares is number && data.yesShares >= 0
        && data.noShares is number && data.noShares >= 0
        && data.yesPoolXAF is number && data.yesPoolXAF >= 0
        && data.noPoolXAF is number && data.noPoolXAF >= 0
        && data.yesProbabilityPct is number && data.yesProbabilityPct >= 1 && data.yesProbabilityPct <= 99
        && data.noProbabilityPct is number && data.noProbabilityPct >= 1 && data.noProbabilityPct <= 99
        && data.totalVolumeXAF is number && data.totalVolumeXAF >= 0
        && (!('sparkline' in data) || (data.sparkline is list && data.sparkline.size() <= 30 && (data.sparkline.size() == 0 || data.sparkline[0] is number)))
        && data.status in ['OPEN', 'RESOLVED_YES', 'RESOLVED_NO']
        && data.closesAt is string && data.closesAt.size() <= 64
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidPredictionVote(data, voteId) {
      return data.keys().hasAll(['id', 'uid', 'predictionId', 'side', 'shares', 'priceXAF', 'totalPaidXAF', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'uid', 'predictionId', 'questionEn', 'questionFr', 'side', 'shares', 'priceXAF', 'totalPaidXAF', 'createdAt'
        ])
        && data.id == voteId
        && data.uid == request.auth.uid
        && isValidId(data.predictionId)
        && (!('questionEn' in data) || (data.questionEn is string && data.questionEn.size() <= 240))
        && (!('questionFr' in data) || (data.questionFr is string && data.questionFr.size() <= 240))
        && data.side in ['YES', 'NO']
        && data.shares is number && data.shares >= 1 && data.shares <= 10000
        && data.priceXAF is number && data.priceXAF > 0
        && data.totalPaidXAF is number && data.totalPaidXAF > 0
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidTrade(data, tradeId) {
      return data.keys().hasAll([
          'id', 'uid', 'creatorId', 'creatorName', 'sharesHeld',
          'entryPriceXAF', 'totalPaidXAF', 'status', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'uid', 'creatorId', 'creatorName', 'creatorHandle',
          'creatorAvatarUrl', 'side', 'sharesHeld', 'entryPriceXAF', 'totalPaidXAF',
          'ownershipPct', 'revSharePct', 'paymentMethod', 'status', 'closesAt', 'roiDurationMonths', 'createdAt'
        ])
        && data.id == tradeId
        && data.uid == request.auth.uid
        && isValidId(data.creatorId)
        && data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 120
        && (!('creatorHandle' in data) || (data.creatorHandle is string && data.creatorHandle.size() <= 80))
        && (!('creatorAvatarUrl' in data) || (data.creatorAvatarUrl is string && data.creatorAvatarUrl.size() <= 500))
        && (!('side' in data) || data.side in ['BUY', 'SELL'])
        && data.sharesHeld is number && data.sharesHeld >= 1 && data.sharesHeld <= 10000
        && data.entryPriceXAF is number && data.entryPriceXAF > 0
        && data.totalPaidXAF is number && data.totalPaidXAF > 0
        && (!('ownershipPct' in data) || (data.ownershipPct is number && data.ownershipPct >= 0 && data.ownershipPct <= 100))
        && (!('revSharePct' in data) || (data.revSharePct is number && data.revSharePct >= 0 && data.revSharePct <= 100))
        && (!('paymentMethod' in data) || data.paymentMethod in ['MTN MoMo', 'Orange Money', 'Wallet'])
        && data.status in ['in_race', 'roi_active', 'settled']
        && (!('closesAt' in data) || (data.closesAt is string && data.closesAt.size() <= 64))
        && (!('roiDurationMonths' in data) || (data.roiDurationMonths is number && data.roiDurationMonths >= 1))
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidWalletTx(data, txId) {
      return data.keys().hasAll(['id', 'uid', 'type', 'network', 'amountXAF', 'reference', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'uid', 'type', 'network', 'phone', 'amountXAF', 'reference', 'status', 'createdAt'])
        && data.id == txId
        && data.uid == request.auth.uid
        && data.type in ['DEPOSIT', 'WITHDRAW', 'TRADE_BUY', 'TRADE_SELL', 'PREDICTION_VOTE', 'ROYALTY_PAYOUT']
        && data.network in ['MTN MoMo', 'Orange Money', 'Wallet']
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && data.amountXAF is number && data.amountXAF > 0
        && data.reference is string && data.reference.size() >= 1 && data.reference.size() <= 120
        && data.status in ['COMPLETED', 'PENDING']
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidNotification(data, notifId) {
      return data.keys().hasAll(['id', 'uid', 'titleEn', 'titleFr', 'kind', 'createdAt'])
        && data.keys().hasOnly(['id', 'uid', 'titleEn', 'titleFr', 'bodyEn', 'bodyFr', 'kind', 'creatorId', 'deltaPct', 'createdAt'])
        && data.id == notifId
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.titleEn is string && data.titleEn.size() >= 2 && data.titleEn.size() <= 160
        && data.titleFr is string && data.titleFr.size() >= 2 && data.titleFr.size() <= 160
        && (!('bodyEn' in data) || (data.bodyEn is string && data.bodyEn.size() <= 360))
        && (!('bodyFr' in data) || (data.bodyFr is string && data.bodyFr.size() <= 360))
        && data.kind in ['CATALYST', 'PRICE_SPIKE', 'DIVIDEND', 'ESCROW']
        && (!('creatorId' in data) || (data.creatorId is string && data.creatorId.size() <= 128))
        && (!('deltaPct' in data) || data.deltaPct is number)
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidBrandCampaign(data, campaignId) {
      return data.keys().hasAll(['id', 'brandName', 'titleEn', 'titleFr', 'budgetXAF', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'brandName', 'agencyName', 'titleEn', 'titleFr', 'category', 'budgetXAF', 'deliverable', 'status', 'createdAt'])
        && data.id == campaignId
        && data.brandName is string && data.brandName.size() >= 1 && data.brandName.size() <= 120
        && (!('agencyName' in data) || (data.agencyName is string && data.agencyName.size() <= 120))
        && data.titleEn is string && data.titleEn.size() >= 2 && data.titleEn.size() <= 180
        && data.titleFr is string && data.titleFr.size() >= 2 && data.titleFr.size() <= 180
        && (!('category' in data) || (data.category is string && data.category.size() <= 80))
        && data.budgetXAF is number && data.budgetXAF >= 0
        && (!('deliverable' in data) || (data.deliverable is string && data.deliverable.size() <= 240))
        && data.status in ['OPEN', 'MATCHED']
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidBrandApplication(data, appId) {
      return data.keys().hasAll(['id', 'campaignId', 'campaignTitle', 'brandName', 'creatorId', 'creatorName', 'uid', 'pitch', 'proposedFeeXAF', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'campaignId', 'campaignTitle', 'brandName', 'creatorId', 'creatorName', 'uid', 'pitch', 'proposedFeeXAF', 'status', 'createdAt'])
        && data.id == appId
        && isValidId(data.campaignId)
        && data.campaignTitle is string && data.campaignTitle.size() >= 2 && data.campaignTitle.size() <= 180
        && data.brandName is string && data.brandName.size() >= 1 && data.brandName.size() <= 120
        && isValidId(data.creatorId)
        && data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 120
        && isValidId(data.uid)
        && data.pitch is string && data.pitch.size() >= 10 && data.pitch.size() <= 600
        && data.proposedFeeXAF is number && data.proposedFeeXAF >= 0
        && data.status in ['pending', 'accepted', 'rejected']
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidApplication(data, appId) {
      return data.keys().hasAll(['id', 'uid', 'stageName', 'handle', 'category', 'pitch', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'uid', 'claimCreatorId', 'stageName', 'handle', 'category', 'city',
          'facebookUrl', 'tiktokUrl', 'verificationMediaUrl',
          'bioVerificationCode', 'kycDocType', 'momoNumber', 'netBudgetXAF', 'totalShares',
          'targetRaiseXAF', 'revSharePct', 'underwritingVerdict',
          'pitch', 'status', 'adminNotes', 'createdAt', 'updatedAt'
        ])
        && data.id == appId
        && isValidId(data.uid)
        && (!('claimCreatorId' in data) || (data.claimCreatorId is string && data.claimCreatorId.size() <= 128))
        && data.stageName is string && data.stageName.size() >= 2 && data.stageName.size() <= 120
        && data.handle is string && data.handle.size() >= 2 && data.handle.size() <= 80
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && (!('city' in data) || (data.city is string && data.city.size() <= 80))
        && (!('facebookUrl' in data) || (data.facebookUrl is string && data.facebookUrl.size() <= 300))
        && (!('tiktokUrl' in data) || (data.tiktokUrl is string && data.tiktokUrl.size() <= 300))
        && (!('verificationMediaUrl' in data) || (data.verificationMediaUrl is string && data.verificationMediaUrl.size() <= 500))
        && (!('bioVerificationCode' in data) || (data.bioVerificationCode is string && data.bioVerificationCode.size() <= 40))
        && (!('kycDocType' in data) || data.kycDocType in ['CNI', 'Passport', 'RCCM'])
        && (!('momoNumber' in data) || (data.momoNumber is string && data.momoNumber.size() <= 40))
        && (!('netBudgetXAF' in data) || (data.netBudgetXAF is number && data.netBudgetXAF >= 0))
        && (!('totalShares' in data) || (data.totalShares is number && data.totalShares >= 1))
        && (!('targetRaiseXAF' in data) || (data.targetRaiseXAF is number && data.targetRaiseXAF >= 0))
        && (!('revSharePct' in data) || (data.revSharePct is number && data.revSharePct >= 0 && data.revSharePct <= 100))
        && (!('underwritingVerdict' in data) || (data.underwritingVerdict is string && data.underwritingVerdict.size() <= 500))
        && data.pitch is string && data.pitch.size() >= 10 && data.pitch.size() <= 1000
        && data.status in ['pending', 'approved', 'rejected']
        && (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 500))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidMemoRequest(data, memoId) {
      return data.keys().hasAll(['id', 'requestedByUid', 'creatorName', 'platform', 'status', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'requestedByUid', 'creatorName', 'handle', 'platform',
          'socialUrl', 'reason', 'status', 'createdAt'
        ])
        && data.id == memoId
        && isValidId(data.requestedByUid)
        && data.creatorName is string && data.creatorName.size() >= 2 && data.creatorName.size() <= 120
        && (!('handle' in data) || (data.handle is string && data.handle.size() <= 80))
        && data.platform in ['TikTok', 'Facebook', 'YouTube', 'Other']
        && (!('socialUrl' in data) || (data.socialUrl is string && data.socialUrl.size() <= 300))
        && (!('reason' in data) || (data.reason is string && data.reason.size() <= 500))
        && data.status in ['pending', 'reviewed', 'listed']
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidNewsPost(data, postId) {
      return data.keys().hasAll(['id', 'sourcePlatform', 'sourceName', 'headline', 'category', 'publishedAt', 'syncedAt'])
        && data.keys().hasOnly([
          'id', 'sourcePlatform', 'sourceName', 'authorHandle', 'headline',
          'thumbnailUrl', 'externalUrl', 'category', 'creatorId', 'creatorName',
          'city', 'sentiment', 'impactPct', 'engagementScore', 'publishedAt', 'syncedAt'
        ])
        && data.id == postId
        && data.sourcePlatform in ['facebook', 'tiktok', 'editorial']
        && data.sourceName is string && data.sourceName.size() >= 1 && data.sourceName.size() <= 120
        && (!('authorHandle' in data) || (data.authorHandle is string && data.authorHandle.size() <= 80))
        && data.headline is string && data.headline.size() >= 3 && data.headline.size() <= 240
        && (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 500))
        && (!('externalUrl' in data) || (data.externalUrl is string && data.externalUrl.size() <= 500))
        && data.category in ['Trending', 'Entertainment', 'Tech', 'Local News', 'Music']
        && (!('creatorId' in data) || (data.creatorId is string && data.creatorId.size() <= 128))
        && (!('creatorName' in data) || (data.creatorName is string && data.creatorName.size() <= 120))
        && (!('city' in data) || (data.city is string && data.city.size() <= 60))
        && (!('sentiment' in data) || data.sentiment in ['POSITIVE', 'NEGATIVE', 'NEUTRAL'])
        && (!('impactPct' in data) || data.impactPct is number)
        && (!('engagementScore' in data) || (data.engagementScore is number && data.engagementScore >= 0))
        && data.publishedAt is string && data.publishedAt.size() <= 64
        && data.syncedAt is string && data.syncedAt.size() <= 64;
    }

    function isValidSyncLog(data, logId) {
      return data.keys().hasAll(['id', 'triggeredByUid', 'provider', 'postsFetched', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'triggeredByUid', 'provider', 'postsFetched', 'metricsUpdated', 'status', 'message', 'createdAt'])
        && data.id == logId
        && isValidId(data.triggeredByUid)
        && data.provider is string && data.provider.size() >= 1 && data.provider.size() <= 80
        && data.postsFetched is number && data.postsFetched >= 0
        && (!('metricsUpdated' in data) || (data.metricsUpdated is number && data.metricsUpdated >= 0))
        && data.status in ['success', 'error', 'unconfigured']
        && (!('message' in data) || (data.message is string && data.message.size() <= 500))
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Connection test doc
    match /test/connection {
      allow get: if true;
    }

    // Admin marker docs
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create, update, delete: if isValidId(userId) && isBootstrappedAdmin();
    }

    // Users collection (PII isolated to owner or admin)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUser(incoming(), userId)
        && incoming().admin == isBootstrappedAdmin()
        && incoming().isVerifiedCreator == false;
      allow update: if isValidId(userId)
        && isValidUser(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin()
          || (
            isOwner(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName', 'city', 'avatarUrl', 'walletBalanceXAF', 'momoPhone', 'momoNetwork', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    // Creators & Active Raises collection (Public market listings)
    match /creators/{creatorId} {
      allow get: if isValidId(creatorId);
      allow list: if true;
      allow create: if isValidId(creatorId)
        && isAdmin()
        && isValidCreator(incoming(), creatorId);
      allow update: if isValidId(creatorId)
        && isValidCreator(incoming(), creatorId)
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin()
          || (
            isSignedIn()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'tradingVolumeXAF', 'totalRaisedXAF', 'sharesRemaining', 'investorsCount',
              'sharePriceXAF', 'priceChangePct', 'sparkline', 'priceHistory', 'updatedAt'
            ])
            && incoming().tradingVolumeXAF >= existing().tradingVolumeXAF
          )
        );
      allow delete: if isValidId(creatorId) && isAdmin();
    }

    // Yes/No Prediction Markets (Public read, signed-in trade pool update, admin create/resolve)
    match /predictions/{predictionId} {
      allow get: if isValidId(predictionId);
      allow list: if true;
      allow create: if isValidId(predictionId)
        && isAdmin()
        && isValidPrediction(incoming(), predictionId);
      allow update: if isValidId(predictionId)
        && isValidPrediction(incoming(), predictionId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin()
          || (
            isSignedIn()
            && existing().status == 'OPEN'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'yesShares', 'noShares', 'yesPoolXAF', 'noPoolXAF',
              'yesProbabilityPct', 'noProbabilityPct', 'totalVolumeXAF', 'sparkline', 'updatedAt'
            ])
            && incoming().totalVolumeXAF > existing().totalVolumeXAF
          )
        );
      allow delete: if isValidId(predictionId) && isAdmin();
    }

    // Private User Prediction Contract Positions
    match /prediction_votes/{voteId} {
      allow get: if isValidId(voteId) && (isOwner(existing().uid) || isAdmin());
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(voteId)
        && isSignedIn()
        && isValidPredictionVote(incoming(), voteId)
        && exists(/databases/$(database)/documents/predictions/$(incoming().predictionId));
      allow update, delete: if false;
    }

    // Trades collection (Private to position owner or admin)
    match /trades/{tradeId} {
      allow get: if isValidId(tradeId) && (isOwner(existing().uid) || isAdmin());
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(tradeId)
        && isSignedIn()
        && isValidTrade(incoming(), tradeId)
        && exists(/databases/$(database)/documents/creators/$(incoming().creatorId));
      allow update: if isValidId(tradeId)
        && isAdmin()
        && isValidTrade(incoming(), tradeId)
        && incoming().id == existing().id
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }

    // Wallet Transactions (MoMo deposits, withdrawals, trade settlements)
    match /wallet_transactions/{txId} {
      allow get: if isValidId(txId) && (isOwner(existing().uid) || isAdmin());
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(txId)
        && isSignedIn()
        && isValidWalletTx(incoming(), txId);
      allow update, delete: if false;
    }

    // Notifications (Global market catalyst alerts & personal alerts)
    match /notifications/{notifId} {
      allow get: if isValidId(notifId) && (existing().uid == 'ALL' || isOwner(existing().uid) || isAdmin());
      allow list: if existing().uid == 'ALL' || (isSignedIn() && (existing().uid == request.auth.uid || isBootstrappedAdmin()));
      allow create: if isValidId(notifId)
        && isSignedIn()
        && isValidNotification(incoming(), notifId)
        && (isAdmin() || incoming().uid == request.auth.uid);
      allow update, delete: if isValidId(notifId) && isAdmin();
    }

    // Brand Campaigns
    match /brand_campaigns/{campaignId} {
      allow get: if isValidId(campaignId);
      allow list: if true;
      allow create, update, delete: if isValidId(campaignId) && isAdmin() && isValidBrandCampaign(incoming(), campaignId);
    }

    // Verified Creator Applications to Brand Campaigns
    match /brand_applications/{appId} {
      allow get: if isValidId(appId) && (isOwner(existing().uid) || isAdmin());
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(appId)
        && isSignedIn()
        && isValidBrandApplication(incoming(), appId)
        && incoming().uid == request.auth.uid
        && incoming().status == 'pending'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isVerifiedCreator == true;
      allow update: if isValidId(appId)
        && isAdmin()
        && isValidBrandApplication(incoming(), appId)
        && incoming().id == existing().id
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }

    // Creator onboarding applications
    match /creator_applications/{appId} {
      allow get: if isValidId(appId) && (isOwner(existing().uid) || isAdmin());
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(appId)
        && isSignedIn()
        && isValidApplication(incoming(), appId)
        && incoming().uid == request.auth.uid
        && incoming().status == 'pending';
      allow update: if isValidId(appId)
        && isAdmin()
        && isValidApplication(incoming(), appId)
        && incoming().id == existing().id
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }

    // Unlisted creator Memo / Listing requests
    match /memo_requests/{memoId} {
      allow get: if isValidId(memoId) && (isOwner(existing().requestedByUid) || isAdmin());
      allow list: if isSignedIn() && (existing().requestedByUid == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(memoId)
        && isSignedIn()
        && isValidMemoRequest(incoming(), memoId)
        && incoming().requestedByUid == request.auth.uid
        && incoming().status == 'pending';
      allow update: if isValidId(memoId)
        && isAdmin()
        && isValidMemoRequest(incoming(), memoId)
        && incoming().id == existing().id
        && incoming().requestedByUid == existing().requestedByUid
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(memoId) && isAdmin();
    }

    // Cultural Catalysts & News Pulse
    match /news_posts/{postId} {
      allow get: if isValidId(postId);
      allow list: if true;
      allow create, update: if isValidId(postId)
        && isAdmin()
        && isValidNewsPost(incoming(), postId);
      allow delete: if isValidId(postId) && isAdmin();
    }

    // Admin Sync Logs
    match /sync_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(logId) && isAdmin() && isValidSyncLog(incoming(), logId);
      allow update, delete: if false;
    }
  }
}
